[Unit]
Description=SimpleLay Kiosk (cage + Chromium fullscreen)
# 백엔드가 떠 있어야 화면에 내용이 있다. getty가 tty1을 잡고 있으면 cage가
# 세션을 못 여니 명시적으로 밀어낸다.
After=simplelay.service systemd-user-sessions.service getty@tty1.service
Wants=simplelay.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=pi
# cage(Wayland 키오스크 컴포지터)가 tty1에서 직접 세션을 연다 — X11/데스크톱
# 환경 불필요, 화면 절전 없음(cage 기본), 크래시 시 systemd가 되살린다.
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/1000

# Flutter 키오스크의 로컬 설정(음성 안내·큰 글씨·선택 가전) 저장 경로.
# 명시하지 않으면 $HOME → 현재 디렉터리 순으로 떨어지는데, 현재 디렉터리가
# 읽기 전용이면 저장이 조용히 실패한다 — 배포에서는 항상 명시한다.
Environment=SIMPLELAY_KIOSK_SETTINGS=/home/pi/SimpleLay/data/kiosk-settings.json

# Flutter 키오스크를 웹으로 빌드해 백엔드가 /kiosk에서 서빙한다(rpi/main.py의
# mount_kiosk). elinux(ipk) 대신 웹을 쓰는 이유: cage+Chromium 인프라가 이미 돌고
# 있어서 주소 한 줄만 바꾸면 되고, 같은 오리진이라 CORS 문제도 없다(백엔드에 CORS
# 미들웨어가 없어서 다른 포트로 띄우면 /status·/events가 전부 막힌다).
#
# 빌드는 PC에서 만들어 복사한다 — scripts/deploy_kiosk.ps1.
# 아직 복사 전이면 /kiosk가 "무엇을 해야 하는지" 안내 화면을 띄운다(404 아님).
#
# **되돌리기**: 실기기에서 너무 느리면 아래 /kiosk/ 를 /ui 로 바꾸면 구형 HTML
# 키오스크로 즉시 후퇴한다. 그쪽은 백엔드에 딸려 있어 항상 뜬다.
#   sudo systemctl edit simplelay-kiosk
ExecStart=/usr/bin/cage -d -- /usr/bin/chromium \
    --kiosk \
    --noerrdialogs \
    --disable-infobars \
    --incognito \
    --check-for-update-interval=31536000 \
    http://localhost:8000/kiosk/

Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target

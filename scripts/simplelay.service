[Unit]
Description=SimpleLay RPi5 FastAPI Backend
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/SimpleLay

# ── 환경 변수 ──────────────────────────────────────────────────────────────
# GPIO 실사용 (DHT22 + 홈 스위치)
Environment=SIMPLELAY_GPIO_ENABLED=true

# DHT22 데이터 핀 BCM 번호 (기본: 4)
Environment=SIMPLELAY_DHT22_GPIO=4

# CoreXY 홈 스위치 핀 (배선 확정 후 수정)
Environment=SIMPLELAY_HOME_X_GPIO=17
Environment=SIMPLELAY_HOME_Y_GPIO=27
# Environment=SIMPLELAY_HOME_Z_GPIO=22  # Z축 확정 후 주석 해제

# SQLite 영속화 — 사용 이력(패턴 학습)·노드 등록이 재시작에도 유지된다
Environment=SIMPLELAY_DB_PATH=/home/pi/SimpleLay/data/simplelay.db

# 기기별 확정 설정(Act 모드·API 키 등)은 이 파일에서 읽는다 — 유닛 파일을
# 고치지 않고 /etc/simplelay/environment만 수정 후 restart하면 된다.
# (setup_rpi.sh가 주석 템플릿을 만들어 둠. '-' 접두사: 없어도 기동)
EnvironmentFile=-/etc/simplelay/environment

# RPi5 GPIO 백엔드 — lgpio 필수
Environment=GPIOZERO_PIN_FACTORY=lgpio

# adafruit-circuitpython 라이브러리 백엔드 — RPi5는 lgpio
Environment=BLINKA_LGPIO=1

# LLM 설정 (필요 시 주석 해제)
# Environment=SIMPLELAY_LLM_MODE=dbus
# Environment=SIMPLELAY_LLM_BASE_URL=https://api.openai.com/v1
# Environment=SIMPLELAY_LLM_API_KEY=sk-...
# Environment=SIMPLELAY_LLM_MODEL=gpt-4o-mini
#
# 온디바이스 D-Bus 서비스 주소는 기기마다 달라서 여기 적지 않는다 —
# 위 EnvironmentFile(/etc/simplelay/environment)에서 넣을 것.
# (SIMPLELAY_DBUS_CLI / _AGENT_SERVICE / _VECTORDB_SERVICE / _PERIPHERAL_SERVICE)

# ── 실행 ───────────────────────────────────────────────────────────────────
ExecStart=/home/pi/SimpleLay/.venv/bin/python -m uvicorn rpi.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --no-access-log

# 키오스크가 상시 의존하는 백엔드라 정상 종료여도 무조건 되살린다
# (on-failure는 exit 0 종료를 방치 — 24/7 운영 기기에는 always가 맞다)
Restart=always
RestartSec=5

# 표준 출력/에러를 syslog + /var/log/simplelay.log 로 동시 기록
StandardOutput=append:/var/log/simplelay.log
StandardError=append:/var/log/simplelay.log

[Install]
WantedBy=multi-user.target

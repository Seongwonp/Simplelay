; secrets.ini.example -> secrets.ini 로 복사해 실제 값을 채운다.
; secrets.ini는 .gitignore에 있어 커밋되지 않는다. 이 예시 파일에는 실제 값을 넣지 않는다.
;
; - 문자열은 \"...\" 로 감싼다(PlatformIO build_flags 규칙). SSID/비밀번호에 공백이
;   있으면 따옴표 처리가 까다로우니 공백 없는 값을 권장.
; - ESPNOW_GATEWAY_MAC은 게이트웨이 ESP32(firmware/)가 부팅 로그에 찍는
;   "own MAC xx:xx:xx:xx:xx:xx"를 바이트 배열로 옮긴다. 공백 없이 쓴다.
[secrets]
build_flags =
    -D WIFI_SSID=\"YOUR_SSID\"
    -D WIFI_PASSWORD=\"YOUR_PASSWORD\"
    -D ESPNOW_GATEWAY_MAC={0x00,0x00,0x00,0x00,0x00,0x00}

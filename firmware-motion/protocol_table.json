{
  "protocol": "line-json/v0",
  "note": "RPi4(rpi/controller/serial_motion.py) <-> 모션 MCU(firmware-motion) 명령 표. 실행 가능한 기준은 rpi/tools/fake_mcu.py이며 rpi/tests/test_motion_protocol_table.py가 셋을 대조한다. 실물 미검증.",
  "commands": {
    "status": {
      "request": ["id", "cmd"],
      "reply": ["id", "ok", "state", "homed", "a", "b", "z", "alarm"],
      "events": []
    },
    "home": {
      "request": ["id", "cmd"],
      "reply": ["id", "ok"],
      "events": []
    },
    "move": {
      "request": ["id", "cmd", "a", "b", "x_mm", "y_mm"],
      "reply": ["id", "ok"],
      "events": ["position"]
    },
    "press": {
      "request_by_mode": {
        "depth": ["id", "cmd", "mode", "z_counts", "dwell_ms"],
        "duration": ["id", "cmd", "mode", "drive_ms", "dwell_ms"]
      },
      "reply": ["id", "ok"],
      "events": ["press_start", "press_end", "position"]
    },
    "stop": {
      "request": ["id", "cmd"],
      "reply": ["id", "ok"],
      "events": []
    }
  },
  "error_reply": ["id", "ok", "error"],
  "errors": [
    "unknown_cmd",
    "bad_args",
    "busy",
    "not_homed",
    "alarm",
    "soft_limit",
    "stopped",
    "stall",
    "limit",
    "home_not_found",
    "timeout",
    "host_timeout",
    "hw_init"
  ],
  "events": {
    "alarm": ["event", "reason"],
    "press_start": ["event"],
    "press_end": ["event"],
    "position": ["event", "a", "b", "z"]
  },
  "position_event_note": "position(엔코더 카운트)은 이동·누름의 ok 응답 직전에 한 번(표의 events 순서) 오고, 이동·누름 중에는 POSITION_EVENT_MS(100ms)마다 더 올 수 있다. 호스트는 선택 이벤트로 다룬다(serial_motion.py last_position).",
  "alarm_reasons": ["stall", "limit", "home_not_found", "timeout", "host_timeout", "soft_limit", "hw_init"],
  "states": ["idle", "homing", "moving", "pressing", "stopped", "alarm"]
}
